    {
      "id": "agent_oak",
      "task": "Build the nearest-neighbour memory from the labelled pool."
    },
    {
      "id": "agent_yew",
      "task": "Carve the held-out test split out of the labelled pool and freeze it."
    },
    {
      "id": "agent_ash",
      "task": "Run the zero-shot and nearest-neighbour conditions on the test split and write the comparison."
    }
  ],
